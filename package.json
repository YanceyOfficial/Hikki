{
  "name": "hikki",
  "private": true,
  "workspaces": [
    "editor",
    "bff"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run --cwd editor typecheck && bun run --cwd bff typecheck",
    "test": "bun run --cwd editor test"
  },
  "devDependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "fontkit": "2.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0"
  }
}
