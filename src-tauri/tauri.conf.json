{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hikki",
  "version": "0.1.0",
  "identifier": "app.yancey.hikki",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hikki",
        "width": 1320,
        "height": 860,
        "decorations": true,
        "hiddenTitle": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 20 },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' hikki-asset: data: blob: http://hikki-asset.localhost",
        "media-src": "'self' hikki-asset: data: blob: http://hikki-asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' hikki-asset: data: blob: http://localhost:1420 http://hikki-asset.localhost",
        "media-src": "'self' hikki-asset: data: blob: http://localhost:1420 http://hikki-asset.localhost",
        "font-src": "'self' data: http://localhost:1420",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
