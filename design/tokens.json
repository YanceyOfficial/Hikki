  "layout": {
    "$comment": "Web editor geometry, one source for its CSS and TypeScript: CSS custom properties (--layout-*) and Tailwind breakpoints in apps/editor/src/theme.css, constants in apps/editor/src/generated/layout.ts. Numbers are px; a [max, reserved] pair is min(max, 100vh - reserved); a string is CSS as it stands. breakpoint.comments is derived, not written: the column, its two gutters and a margin card with its gap. popover-padding is the inset of every menu and popover — the block menu, the slash menu, the selection menu and its panels, the toolbars over media and tables, shadcn's dropdowns — one value, so they match (ISSUE-234).",
    "column-gutter": 96,
    "column-gutter-min": 56,
    "viewport-gutter": 8,
    "page-icon": 78,
    "comment-card": 300,
    "comment-gap": 40,
    "outline-rail": 64,
    "popover-padding": 6,
    "panel": {
      "menu": 224,
      "date": 272,
      "slash": 280,
      "ruby": 320,
      "caption": 360,
      "default": 400,
      "cover": 440,
      "find": 440,
      "review": 520,
      "math": 640
    },
