    "app:ai.error.badBaseURL %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ address in Settings → AI isn’t usable: use https (http only to this device)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置 → AI”中的 %@ 地址无法使用：请使用 https（http 只限本机）。"
          }
        }
      }
    },
    "app:ai.error.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer couldn’t be read. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取回答。请重试。"
          }
        }
      }
    },
    "app:ai.error.missingKey %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your %@ API key in Settings → AI to use this model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置 → AI”中填写 %@ 的 API 密钥后再使用这个模型。"
          }
        }
      }
    },
    "app:ai.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. Check your network and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络连接。请检查网络后重试。"
          }
        }
      }
    },
    "app:ai.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests, or the account’s quota is used up. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求过多，或账户额度已用完。请稍后再试。"
          }
        }
      }
    },
    "app:ai.error.rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求被拒绝。"
          }
        }
      }
