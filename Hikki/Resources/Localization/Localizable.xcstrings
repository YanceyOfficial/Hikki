      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A zip of the logs, crash reports and app details, to attach to a bug report. Each error shows a code and an incident ID (Copy details) you can look up in it. It never contains your pages’ content, titles or API keys."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含日志、崩溃报告和应用信息的压缩包，可附在问题反馈中。每个错误都会显示错误码和事件 ID（复制详情），可在其中查到对应记录。不包含页面内容、标题或 API 密钥。"
          }
        }
      }
    },
