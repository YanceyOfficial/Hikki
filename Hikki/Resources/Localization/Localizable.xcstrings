    "app:ai.chat.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask anything — AI can search the web too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问点什么吧，AI 也能搜索网页。"
          }
        }
      }
    },
    "app:ai.chat.emptyPage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask about this page, or anything else."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以问这个页面的内容，也可以问别的。"
          }
        }
      }
    },
    "app:ai.chat.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask or do anything with AI…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 回答或帮你做点什么…"
          }
        }
