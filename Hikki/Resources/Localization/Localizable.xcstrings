    "app:ai.settings.models.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto balances speed, effort and cost among the providers you have a key for. You can pick another model for each request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会在已填写密钥的服务商中兼顾速度、效果与成本。每次请求时也可以另选模型。"
          }
        }
      }
    },
    "app:ai.settings.openai.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for GPT models. Create a key at platform.openai.com. It is kept in the Keychain on this device and sent only to the address above (OpenAI when blank), together with the text you ask AI about. A key belongs to the address it was entered for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
