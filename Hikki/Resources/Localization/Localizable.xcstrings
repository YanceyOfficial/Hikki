    "app:ai.settings.files": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use files in the workspace folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用工作区文件夹中的文件"
          }
        }
      }
    },
    "app:ai.settings.files.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off until you turn it on. In Ask AI, AI can then list, read and search the files in your workspace folder, and write or edit them once you allow each change. What it reads goes to the AI provider with your question — a file can hold instructions meant for the AI, so turn this on only for folders you trust. Hikki's own data (pages, history, comments) is never written."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，需要你手动开启。开启后，在“问 AI”中，AI 可以列出、读取和搜索工作区文件夹中的文件；每次写入或编辑都需你先允许。它读取的内容会随你的问题一起发送给 AI 服务商——文件中可能藏有写给 AI 的指令，因此只在你信任的文件夹上开启。Hikki 自己的数据（页面、历史、评论）不会被写入。"
          }
        }
      }
    },
    "app:ai.settings.history": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
