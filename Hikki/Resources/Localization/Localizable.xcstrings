    "app:ai.settings.keys.sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keys are kept in iCloud Keychain: end-to-end encrypted, they reach your other devices signed in to the same Apple Account. Each key is still sent only to the address it was entered for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在 iCloud 钥匙串中：端到端加密，会同步到登录同一 Apple 账户的其他设备。每个密钥仍只发送到输入它时对应的地址。"
          }
        }
      }
    },
