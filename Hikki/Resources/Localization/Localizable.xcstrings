    "app:settings.transfer.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring in many Markdown, HTML, text or Hikki JSON files at once: a folder becomes a page with its files as subpages, and pictures they link come along. Export writes every page into a new folder that mirrors the page tree, attachments in assets/. A single page exports from its ⋯ menu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次导入多个 Markdown、HTML、文本或 Hikki JSON 文件：文件夹会成为页面，其中的文件成为子页面，链接的图片一并导入。导出会把所有页面写入一个按页面树组织的新文件夹，附件放在 assets/ 中。单个页面可从它的 ⋯ 菜单导出。"
          }
        }
      }
    },
