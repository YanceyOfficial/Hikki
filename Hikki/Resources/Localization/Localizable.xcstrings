    "app:ai.settings.history.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each page keeps one conversation with AI, in the workspace folder, synced with the page. Older messages are deleted on every device; a page deleted for good takes its conversation along."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个页面保留一段与 AI 的对话，存放在工作区文件夹中，随页面同步。超过期限的消息会在所有设备上删除；页面被永久删除时，其对话也一并删除。"
          }
        }
      }
    },
    "app:ai.settings.history.keep": {
      "extractionState": "manual",
      "localizations": {
