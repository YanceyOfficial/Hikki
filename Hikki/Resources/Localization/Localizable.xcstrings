    "app:ai.error.badBaseURL %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ address in Settings → AI isn’t usable: use https (http only to this device)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“设置 → AI”中的 %@ 地址无法使用：请使用 https（http 只限本机）。"
          }
        }
      }
    },
    "app:ai.error.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer couldn’t be read. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取回答。请重试。"
          }
