    "app:ai.settings.anthropic.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for Claude models (Opus, Sonnet, Haiku). Create a key at console.anthropic.com. It is kept in the Keychain on this device and sent only to the address above (Anthropic when blank), together with the text you ask AI about. A key belongs to the address it was entered for."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于 Claude 模型（Opus、Sonnet、Haiku）。可在 console.anthropic.com 创建密钥。密钥只保存在本设备的钥匙串中，只会和你让 AI 处理的文字一起发送到上面的地址（留空即 Anthropic）。每个地址的密钥分开保存。"
          }
        }
      }
    },
