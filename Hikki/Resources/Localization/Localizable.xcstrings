    "app:ai.review.diff.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each changed line appears before and after, like a code diff. Clearest for long rewrites. What AI says about the text comes in a card below, to copy or insert."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一行修改都以前后对照的方式显示，像代码对比。适合大段改写。AI 对文字的说明显示在下方卡片中，可复制或插入。"
          }
        }
      }
    },
