{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "none",
  "ignorePatterns": [
    "bun.lock",
    "node_modules/",
    "Hikki/Resources/",
    "Derived/",
    "Tuist/.build/",
    "apps/editor/public/",
    "apps/editor/src/theme.css",
    "apps/editor/src/generated/",
    "apps/bff/src/generated/",
    "apps/website/src/routeTree.gen.ts",
    "apps/website/.output/",
    "HikkiUI/Sources/Generated/",
    "*.xcodeproj/",
    "*.xcworkspace/",
    "HikkiUI/Resources/"
  ],
  "sortImports": {
    "enabled": true
  },
  "sortTailwindcss": {
    "enabled": true,
    "stylesheet": "./apps/editor/src/style.css"
  },
  "sortPackageJson": {
    "enabled": true
  }
}
